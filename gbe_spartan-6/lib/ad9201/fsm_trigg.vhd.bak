library ieee;
use ieee.std_logic_1164.all;

entity fsm_trigg is

	port(
	
	RST,CLK : in std_logic;
	
	trigg_sw0 : in std_logic;
	sw0 : in std_logic;
	end_sample : in std_logic;
	
	start_ram : out std_logic;
	data_last : out std_logic
	
	);
end fsm_trigg;

architecture fsm of fsm_trigg is	


signal qp, qn : std_logic_vector(3 downto 0);

begin  
	
	c1 : process(qp,trigg_sw0,sw0,end_sample)
	begin
		
		case(qp) is
		
		--s0
		when "0000" =>
		start_ram <= '0'; 
		data_last <= '0';
		
		if((trigg_sw0='1') and (sw0 = '0')) then
			qn <= "0001";
		else
			qn <= "0000";
		end if;
		
		--s1
		when "0001" =>
		start_ram <= '1'; 
		data_last <= '1';
		
		qn <= "0010";
		
		--s2
		when "0010" =>
		start_ram <= '0'; 
		data_last <= '1';
		
		if(end_sample = '1') then
			qn <= "0000";
		else 
			qn <= "0010";
		end if;
		
	
		end case;
		
	end process;
	
	secuencial : process(RST,CLK)
	begin
		if(RST='0') then
			qp <= (others => '0');
		elsif(CLK'event and CLK='1') then
			qp <= qn;
		end if;
	end process;
	
end fsm;