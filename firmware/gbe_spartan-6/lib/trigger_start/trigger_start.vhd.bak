library ieee;
use ieee.std_logic_1164.all;
use ieee.std_logic_unsigned.all;

entity trigger_start is	
	
	port(
	
	RST,CLK : in std_logic;
	y : out std_logic
	
	);	
	
end trigger_start;

architecture fsm of trigger_start is	


component contador_bt_trigger_start is  
	
	generic(
	
	n :	integer := 20;
	c : integer := 1041666
	
	);
	
	port(
	
	RST,CLK : in std_logic;
	
	BT : out std_logic
	
	); 
	
end component; 

component fsm_trigger_start is

	port(
	
	RST,CLK : in std_logic;
	bt : in std_logic;
	y : out std_logic
	
	);
	
end component;	

signal bt : std_logic;	

begin 
	
	sc0 : contador_bt_trigger_start port map(RST,CLK,bt);
	
	sc1: fsm_trigger_start port map(RST,CLK,bt,y);
	
	
end fsm;